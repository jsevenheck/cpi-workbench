<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic test model shaped like an exported iFlow (BPMN 2 with ifl:property key/value pairs; processes, flows
     and diagram as in public exports, plan F68).
     The real format is not publicly specified; the importer reads it generically. -->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ifl="http:///com.sap.ifl.model/Ifl.xsd" id="Definitions_1">
  <bpmn2:collaboration id="Collaboration_1" name="Default Collaboration">
    <bpmn2:extensionElements><ifl:property><key>namespaceMapping</key><value></value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::IFlowVariant/cname::IFlowConfiguration/version::1.2.0</value></ifl:property></bpmn2:extensionElements>
    <bpmn2:participant id="Participant_1" ifl:type="EndpointSender" name="Shop"><bpmn2:extensionElements><ifl:property><key>enableBasicAuthentication</key><value>false</value></ifl:property><ifl:property><key>ifl:type</key><value>EndpointSender</value></ifl:property></bpmn2:extensionElements></bpmn2:participant>
    <bpmn2:participant id="Participant_2" ifl:type="EndpointRecevier" name="S4"><bpmn2:extensionElements><ifl:property><key>ifl:type</key><value>EndpointRecevier</value></ifl:property></bpmn2:extensionElements></bpmn2:participant>
    <bpmn2:participant id="Participant_Process_1" ifl:type="IntegrationProcess" name="Integration Process" processRef="Process_1"><bpmn2:extensionElements></bpmn2:extensionElements></bpmn2:participant>
    <bpmn2:participant id="Participant_Process_2" ifl:type="IntegrationProcess" name="Archive order" processRef="Process_2"><bpmn2:extensionElements></bpmn2:extensionElements></bpmn2:participant>
    <bpmn2:messageFlow id="MessageFlow_1" name="HTTPS" sourceRef="Participant_1" targetRef="StartEvent_1"><bpmn2:extensionElements><ifl:property><key>ComponentType</key><value>HTTPS</value></ifl:property><ifl:property><key>direction</key><value>Sender</value></ifl:property><ifl:property><key>urlPath</key><value>/orders</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::AdapterVariant/cname::sap:HTTPS/tp::HTTPS/mp::None/direction::Sender/version::1.5.0</value></ifl:property></bpmn2:extensionElements></bpmn2:messageFlow>
    <bpmn2:messageFlow id="MessageFlow_2" name="SOAP" sourceRef="EndEvent_1" targetRef="Participant_2"><bpmn2:extensionElements><ifl:property><key>ComponentType</key><value>SOAP</value></ifl:property><ifl:property><key>direction</key><value>Receiver</value></ifl:property><ifl:property><key>address</key><value>https://s4.example.com/orders</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::AdapterVariant/cname::sap:SOAP/tp::HTTP/mp::SOAP 1.x/direction::Receiver/version::1.11.0</value></ifl:property></bpmn2:extensionElements></bpmn2:messageFlow>
  </bpmn2:collaboration>
  <bpmn2:process id="Process_1" name="Integration Process">
    <bpmn2:extensionElements><ifl:property><key>transactionTimeout</key><value>30</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowElementVariant/cname::IntegrationProcess/version::1.2.1</value></ifl:property></bpmn2:extensionElements>
    <bpmn2:callActivity id="CallActivity_1" name="Enrich order">
      <bpmn2:extensionElements>
        <ifl:property><key>scriptFunction</key><value>enrich</value></ifl:property>
        <ifl:property><key>componentVersion</key><value>2.0</value></ifl:property>
        <ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>subActivityType</key><value>GroovyScript</value></ifl:property>
        <ifl:property><key>script</key><value>enrich.groovy</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_2" name="Map to sales order">
      <bpmn2:extensionElements>
        <ifl:property><key>componentVersion</key><value>1.2</value></ifl:property>
        <ifl:property><key>activityType</key><value>Mapping</value></ifl:property>
        <ifl:property><key>subActivityType</key><value>XSLTMapping</value></ifl:property>
        <ifl:property><key>mappinguri</key><value>dir://mapping/xslt/src/main/resources/mapping/order.xsl</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <!-- Shapes seen in SAP's public sample iFlows: empty scriptFunction, mapping name from a header,
         an XML Validator step (the schema key name is assumed). -->
    <bpmn2:callActivity id="CallActivity_4" name="Log payload">
      <bpmn2:extensionElements>
        <ifl:property><key>scriptFunction</key><value/></ifl:property>
        <ifl:property><key>componentVersion</key><value>1.0</value></ifl:property>
        <ifl:property><key>activityType</key><value>Script</value></ifl:property>
        <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::GroovyScript/version::1.0.1</value></ifl:property>
        <ifl:property><key>subActivityType</key><value>GroovyScript</value></ifl:property>
        <ifl:property><key>script</key><value>enrich.groovy</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_5" name="Dynamic mapping">
      <bpmn2:extensionElements>
        <ifl:property><key>mappingHeaderNameKey</key><value>xsltmappingname</value></ifl:property>
        <ifl:property><key>mappingSource</key><value>mappingSrcHeader</value></ifl:property>
        <ifl:property><key>activityType</key><value>Mapping</value></ifl:property>
        <ifl:property><key>subActivityType</key><value>XSLTMapping</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_6" name="Validate">
      <bpmn2:extensionElements>
        <ifl:property><key>componentVersion</key><value>2.0</value></ifl:property>
        <ifl:property><key>activityType</key><value>XmlValidator</value></ifl:property>
        <ifl:property><key>xmlSchemaSource</key><value>/xsd/order.xsd</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <!-- Content Modifier, Splitter, Filter, Gather and Router keys as seen in SAP's public sample iFlows (synthetic values). -->
    <bpmn2:callActivity id="CallActivity_3" name="Set headers">
      <bpmn2:extensionElements>
        <ifl:property><key>bodyType</key><value>expression</value></ifl:property>
        <ifl:property><key>propertyTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;{{LogLevel}}&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;P_Log&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
        <ifl:property><key>headerTable</key><value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;xpath&lt;/cell&gt;&lt;cell id='Value'&gt;//Order/@id&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;OrderId&lt;/cell&gt;&lt;cell id='Datatype'&gt;java.lang.String&lt;/cell&gt;&lt;/row&gt;&lt;row&gt;&lt;cell id='Action'&gt;Delete&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;$include=X-*&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
        <ifl:property><key>wrapContent</key><value>&lt;Wrapped&gt;${in.body}&lt;/Wrapped&gt;</value></ifl:property>
        <ifl:property><key>componentVersion</key><value>1.6</value></ifl:property>
        <ifl:property><key>activityType</key><value>Enricher</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_7" name="Split items">
      <bpmn2:extensionElements>
        <ifl:property><key>exprType</key><value>XPath</value></ifl:property>
        <ifl:property><key>Streaming</key><value>true</value></ifl:property>
        <ifl:property><key>splitExprValue</key><value>/Order/Item/</value></ifl:property>
        <ifl:property><key>activityType</key><value>Splitter</value></ifl:property>
        <ifl:property><key>grouping</key><value>{{GroupSize}}</value></ifl:property>
        <ifl:property><key>splitType</key><value>GeneralSplitter</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_8" name="Gather items">
      <bpmn2:extensionElements>
        <ifl:property><key>gatherFileNames</key><value/></ifl:property>
        <ifl:property><key>sourceXPath</key><value>/Order/Item</value></ifl:property>
        <ifl:property><key>targetXPath</key><value/></ifl:property>
        <ifl:property><key>componentVersion</key><value>1.2</value></ifl:property>
        <ifl:property><key>messageType</key><value>SameXMLFormat</value></ifl:property>
        <ifl:property><key>activityType</key><value>Gather</value></ifl:property>
        <ifl:property><key>aggregationAlgorithm</key><value>xpath-merge-strategy</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_9" name="Keep items">
      <bpmn2:extensionElements>
        <ifl:property><key>xpathType</key><value>Nodelist</value></ifl:property>
        <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
        <ifl:property><key>activityType</key><value>Filter</value></ifl:property>
        <ifl:property><key>wrapContent</key><value>/Order/Item</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <!-- A Message Mapping step as in SAP's sample iFlows: activityType Mapping, mappinguri dir://mmap/... -->
    <bpmn2:callActivity id="CallActivity_10" name="Map order">
      <bpmn2:extensionElements>
        <ifl:property><key>mappingname</key><value>order</value></ifl:property>
        <ifl:property><key>mappingpath</key><value>src/main/resources/mapping/order</value></ifl:property>
        <ifl:property><key>activityType</key><value>Mapping</value></ifl:property>
        <ifl:property><key>mappinguri</key><value>dir://mmap/src/main/resources/mapping/order.mmap</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <!-- Converters with the keys seen in public iFlows (synthetic values). -->
    <bpmn2:callActivity id="CallActivity_11" name="JSON to XML">
      <bpmn2:extensionElements>
        <ifl:property><key>componentVersion</key><value>1.1</value></ifl:property>
        <ifl:property><key>activityType</key><value>JsonToXmlConverter</value></ifl:property>
        <ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::JsonToXmlConverter/version::1.1.2</value></ifl:property>
        <ifl:property><key>useNamespaces</key><value>true</value></ifl:property>
        <ifl:property><key>jsonNamespaceSeparator</key><value>:</value></ifl:property>
        <ifl:property><key>jsonNamespaceMapping</key><value>&lt;row&gt;&lt;cell&gt;ord&lt;/cell&gt;&lt;cell&gt;urn:orders&lt;/cell&gt;&lt;/row&gt;</value></ifl:property>
        <ifl:property><key>addXMLRootElement</key><value>true</value></ifl:property>
        <ifl:property><key>additionalRootElementName</key><value>{{RootName}}</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:callActivity id="CallActivity_12" name="CSV to XML">
      <bpmn2:extensionElements>
        <ifl:property><key>componentVersion</key><value>1.4</value></ifl:property>
        <ifl:property><key>activityType</key><value>CsvToXmlConverter</value></ifl:property>
        <ifl:property><key>XML_Schema_File_Path</key><value>/xsd/order.xsd</value></ifl:property>
        <ifl:property><key>XPath_Field_Location</key><value>Order/Item</value></ifl:property>
        <ifl:property><key>Field_Separator_in_CSV</key><value>;</value></ifl:property>
        <ifl:property><key>ignoreFirstLineAsHeader</key><value>true</value></ifl:property>
        <ifl:property><key>headerMapping</key><value>mapHeadersToXSD</value></ifl:property>
      </bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:exclusiveGateway default="SequenceFlow_9" id="ExclusiveGateway_1" name="Check sender">
      <bpmn2:extensionElements>
        <ifl:property><key>activityType</key><value>ExclusiveGateway</value></ifl:property>
        <ifl:property><key>throwException</key><value>false</value></ifl:property>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>SequenceFlow_8</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_9</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="SequenceFlow_9" name="Other" sourceRef="ExclusiveGateway_1" targetRef="CallActivity_1">
      <bpmn2:extensionElements><ifl:property><key>expressionType</key><value>XML</value></ifl:property></bpmn2:extensionElements>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="SequenceFlow_8" name="ERP" sourceRef="ExclusiveGateway_1" targetRef="CallActivity_2">
      <bpmn2:extensionElements><ifl:property><key>expressionType</key><value>NonXML</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${header.SenderId} = 'ERP'</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:startEvent id="StartEvent_1" name="Start"><bpmn2:extensionElements><ifl:property><key>componentVersion</key><value>1.0</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageStartEvent/version::1.0</value></ifl:property></bpmn2:extensionElements><bpmn2:messageEventDefinition/></bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent_1" name="End"><bpmn2:extensionElements><ifl:property><key>componentVersion</key><value>1.1</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::MessageEndEvent/version::1.1.0</value></ifl:property></bpmn2:extensionElements><bpmn2:messageEventDefinition/></bpmn2:endEvent>
    <bpmn2:callActivity id="CallActivity_13" name="Archive">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>ProcessCallElement</value></ifl:property><ifl:property><key>subActivityType</key><value>NonLoopingProcess</value></ifl:property><ifl:property><key>processId</key><value>Process_2</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::NonLoopingProcess/version::1.0.3</value></ifl:property></bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:sequenceFlow id="SequenceFlow_20" sourceRef="StartEvent_1" targetRef="CallActivity_3"/>
    <bpmn2:sequenceFlow id="SequenceFlow_21" sourceRef="CallActivity_3" targetRef="CallActivity_6"/>
    <bpmn2:sequenceFlow id="SequenceFlow_22" sourceRef="CallActivity_6" targetRef="CallActivity_7"/>
    <bpmn2:sequenceFlow id="SequenceFlow_23" sourceRef="CallActivity_7" targetRef="CallActivity_9"/>
    <bpmn2:sequenceFlow id="SequenceFlow_24" sourceRef="CallActivity_9" targetRef="CallActivity_8"/>
    <bpmn2:sequenceFlow id="SequenceFlow_25" sourceRef="CallActivity_8" targetRef="ExclusiveGateway_1"/>
    <bpmn2:sequenceFlow id="SequenceFlow_26" sourceRef="CallActivity_2" targetRef="CallActivity_10"/>
    <bpmn2:sequenceFlow id="SequenceFlow_27" sourceRef="CallActivity_10" targetRef="CallActivity_11"/>
    <bpmn2:sequenceFlow id="SequenceFlow_28" sourceRef="CallActivity_11" targetRef="CallActivity_12"/>
    <bpmn2:sequenceFlow id="SequenceFlow_29" sourceRef="CallActivity_12" targetRef="CallActivity_13"/>
    <bpmn2:sequenceFlow id="SequenceFlow_30" sourceRef="CallActivity_13" targetRef="EndEvent_1"/>
    <bpmn2:sequenceFlow id="SequenceFlow_31" sourceRef="CallActivity_1" targetRef="CallActivity_4"/>
    <bpmn2:sequenceFlow id="SequenceFlow_32" sourceRef="CallActivity_4" targetRef="CallActivity_5"/>
    <bpmn2:sequenceFlow id="SequenceFlow_33" sourceRef="CallActivity_5" targetRef="EndEvent_1"/>
    <bpmn2:subProcess id="SubProcess_1" name="Exception Subprocess 1">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>ErrorEventSubProcessTemplate</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::ErrorEventSubProcessTemplate/version::1.1.0</value></ifl:property></bpmn2:extensionElements>
      <bpmn2:startEvent id="StartEvent_3" name="Error Start"><bpmn2:extensionElements><ifl:property><key>activityType</key><value>StartErrorEvent</value></ifl:property></bpmn2:extensionElements><bpmn2:errorEventDefinition/></bpmn2:startEvent>
      <bpmn2:endEvent id="EndEvent_3" name="Error End"><bpmn2:extensionElements><ifl:property><key>activityType</key><value>EndErrorEvent</value></ifl:property></bpmn2:extensionElements><bpmn2:errorEventDefinition/></bpmn2:endEvent>
      <bpmn2:sequenceFlow id="SequenceFlow_40" sourceRef="StartEvent_3" targetRef="EndEvent_3"/>
    </bpmn2:subProcess>
  </bpmn2:process>
  <bpmn2:process id="Process_2" name="Archive order">
    <bpmn2:extensionElements><ifl:property><key>processType</key><value>directCall</value></ifl:property><ifl:property><key>transactionalHandling</key><value>From Calling Process</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowElementVariant/cname::LocalIntegrationProcess/version::1.1.3</value></ifl:property></bpmn2:extensionElements>
    <bpmn2:startEvent id="StartEvent_2" name="Start 1"><bpmn2:extensionElements><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::StartEvent</value></ifl:property></bpmn2:extensionElements></bpmn2:startEvent>
    <bpmn2:callActivity id="CallActivity_14" name="Write to data store">
      <bpmn2:extensionElements><ifl:property><key>activityType</key><value>DBstorage</value></ifl:property><ifl:property><key>subActivityType</key><value>put</value></ifl:property><ifl:property><key>storageName</key><value>orders</value></ifl:property><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::put/version::1.6.0</value></ifl:property></bpmn2:extensionElements>
    </bpmn2:callActivity>
    <bpmn2:endEvent id="EndEvent_2" name="End 1"><bpmn2:extensionElements><ifl:property><key>cmdVariantUri</key><value>ctype::FlowstepVariant/cname::EndEvent</value></ifl:property></bpmn2:extensionElements></bpmn2:endEvent>
    <bpmn2:sequenceFlow id="SequenceFlow_50" sourceRef="StartEvent_2" targetRef="CallActivity_14"/>
    <bpmn2:sequenceFlow id="SequenceFlow_51" sourceRef="CallActivity_14" targetRef="EndEvent_2"/>
  </bpmn2:process>
  <bpmndi:BPMNDiagram xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="BPMNDiagram_1" name="Default Collaboration Diagram">
    <bpmndi:BPMNPlane bpmnElement="Collaboration_1" id="BPMNPlane_1">
      <bpmndi:BPMNShape bpmnElement="Participant_1" id="BPMNShape_Participant_1"><dc:Bounds height="140.0" width="100.0" x="60.0" y="210.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Participant_2" id="BPMNShape_Participant_2"><dc:Bounds height="140.0" width="100.0" x="2100.0" y="210.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Participant_Process_1" id="BPMNShape_Participant_Process_1"><dc:Bounds height="440.0" width="1800.0" x="240.0" y="100.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Participant_Process_2" id="BPMNShape_Participant_Process_2"><dc:Bounds height="200.0" width="600.0" x="240.0" y="620.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="StartEvent_1" id="BPMNShape_StartEvent_1"><dc:Bounds height="32.0" width="32.0" x="280.0" y="264.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_3" id="BPMNShape_CallActivity_3"><dc:Bounds height="60.0" width="100.0" x="350.0" y="250.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_6" id="BPMNShape_CallActivity_6"><dc:Bounds height="60.0" width="100.0" x="480.0" y="250.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_7" id="BPMNShape_CallActivity_7"><dc:Bounds height="60.0" width="100.0" x="610.0" y="250.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_9" id="BPMNShape_CallActivity_9"><dc:Bounds height="60.0" width="100.0" x="740.0" y="250.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_8" id="BPMNShape_CallActivity_8"><dc:Bounds height="60.0" width="100.0" x="870.0" y="250.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="ExclusiveGateway_1" id="BPMNShape_ExclusiveGateway_1"><dc:Bounds height="40.0" width="40.0" x="1010.0" y="260.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_2" id="BPMNShape_CallActivity_2"><dc:Bounds height="60.0" width="100.0" x="1090.0" y="150.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_10" id="BPMNShape_CallActivity_10"><dc:Bounds height="60.0" width="100.0" x="1220.0" y="150.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_11" id="BPMNShape_CallActivity_11"><dc:Bounds height="60.0" width="100.0" x="1350.0" y="150.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_12" id="BPMNShape_CallActivity_12"><dc:Bounds height="60.0" width="100.0" x="1480.0" y="150.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_13" id="BPMNShape_CallActivity_13"><dc:Bounds height="60.0" width="100.0" x="1610.0" y="150.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_1" id="BPMNShape_CallActivity_1"><dc:Bounds height="60.0" width="100.0" x="1090.0" y="350.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_4" id="BPMNShape_CallActivity_4"><dc:Bounds height="60.0" width="100.0" x="1220.0" y="350.0"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="CallActivity_5" id="BPMNShape_CallActivity_5"><dc:Bounds height="60.0" width="100.0" x="1350.0" y="350.0"/></bpmndi:BPMNShape>
