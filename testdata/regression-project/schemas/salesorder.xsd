<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="SalesOrder">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Header">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ExternalReference" type="xs:string"/>
              <xs:element name="SoldTo" type="xs:string"/>
              <xs:element name="CustomerGroup" type="xs:string"/>
              <xs:element name="ShippingCondition">
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[0-9]{2}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="Source" type="xs:string"/>
              <xs:element name="OrderDate">
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[0-9]{8}"/></xs:restriction></xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Item" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Position" type="xs:string"/>
              <xs:element name="Material" type="xs:string"/>
              <xs:element name="Quantity" type="xs:positiveInteger"/>
              <xs:element name="NetAmount" type="xs:decimal"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="TotalNetAmount" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
