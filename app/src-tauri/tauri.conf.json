{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPI Workbench",
  "version": "0.1.1",
  "identifier": "io.cpiwb.workbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CPI Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "CPI Workbench contributors",
    "copyright": "Copyright 2026 CPI Workbench contributors. Apache-2.0.",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/jsevenheck/cpi-workbench",
    "shortDescription": "Local SAP Cloud Integration mapping simulator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cpiwb-xml-he99",
      "binaries/cpiwb-xml-he12"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "resources": {
      "resources/engines/": "engines/",
      "resources/jre/": "jre/",
      "resources/licenses/": "licenses/"
    }
  }
}
