<?xml version="1.0" encoding="UTF-8"?>
<!-- Target of the Probe_Mapping message mapping (probes/README.md, step 6): each Info holds the JSON
     that one call of describeQueue returned. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="Result">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Info" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
