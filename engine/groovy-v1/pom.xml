<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cpiwb</groupId>
    <artifactId>cpiwb-engine-parent</artifactId>
    <version>0.1.1</version>
  </parent>
  <artifactId>cpiwb-groovy-v1</artifactId>
  <name>CPI Workbench Groovy engine 1.x (Groovy 2.4.21, Camel 2, Script API v1)</name>
  <description>Built from the shared sources in ../groovy plus version-specific glue.</description>

  <dependencies>
    <dependency>
      <groupId>io.cpiwb</groupId>
      <artifactId>cpiwb-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy-all</artifactId>
      <version>2.4.21</version>
    </dependency>
    <dependency>
      <groupId>org.apache.camel</groupId>
      <artifactId>camel-core</artifactId>
      <version>2.24.3</version>
    </dependency>
    <dependency>
      <groupId>com.sun.activation</groupId>
      <artifactId>javax.activation</artifactId>
      <version>1.2.0</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jayway.jsonpath</groupId>
      <artifactId>json-path</artifactId>
      <version>2.10.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>../groovy/src/main/java</source>
                <source>../groovy/src/api-common/java</source>
                <source>../groovy/src/camel2/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-tests</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources><source>../groovy/src/test/java</source></sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-test-resources</id>
            <phase>generate-test-resources</phase>
            <goals><goal>add-test-resource</goal></goals>
            <configuration>
              <resources><resource><directory>../groovy/src/test/resources</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>cpiwb-groovy-v1</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.cpiwb.groovy.camel.Launcher</mainClass>
                  <manifestEntries><Multi-Release>true</Multi-Release></manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/services/org/apache/camel/TypeConverterLoader</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/services/org/apache/camel/TypeConverter</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/groovy/org.codehaus.groovy.runtime.ExtensionModule</resource>
                </transformer>
              </transformers>
              <!-- The JSONPath tester's library stays off the classpath scripts see (CPI has no such jar unless a script adds it). -->
              <relocations>
                <relocation><pattern>com.jayway.jsonpath</pattern><shadedPattern>io.cpiwb.shaded.jsonpath</shadedPattern></relocation>
                <relocation><pattern>net.minidev</pattern><shadedPattern>io.cpiwb.shaded.minidev</shadedPattern></relocation>
                <relocation><pattern>org.objectweb.asm</pattern><shadedPattern>io.cpiwb.shaded.asm</shadedPattern></relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
