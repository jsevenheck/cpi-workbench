<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.cpiwb</groupId>
    <artifactId>cpiwb-engine-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>cpiwb-xml-he99</artifactId>
  <name>CPI Workbench XML engine (Saxon-HE 9.9.1-8)</name>
  <description>Built from the shared sources in ../xml plus the Saxon-version glue in ../xml/src/saxon99.</description>

  <properties>
    <saxon.version>9.9.1-8</saxon.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.cpiwb</groupId>
      <artifactId>cpiwb-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.sf.saxon</groupId>
      <artifactId>Saxon-HE</artifactId>
      <version>${saxon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>shared-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>../xml/src/main/java</source>
                <source>../xml/src/saxon99/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-tests</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources><source>../xml/src/test/java</source></sources>
            </configuration>
          </execution>
          <execution>
            <id>shared-test-resources</id>
            <phase>generate-test-resources</phase>
            <goals><goal>add-test-resource</goal></goals>
            <configuration>
              <resources><resource><directory>../xml/src/test/resources</directory></resource></resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>cpiwb-xml-he99</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.cpiwb.xml.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
